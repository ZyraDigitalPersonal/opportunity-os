{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opportunity-os",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // El Worker comprueba la sesión antes de servir cualquier archivo
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  // IA gratuita de Cloudflare (Workers AI): asistente de ayuda y textos comerciales sin clave de pago
  "ai": { "binding": "AI" },
  // Interruptores de administrador (Google, mapa, IA…) guardados en KV
  // Pipeline comercial (CRM)
  "d1_databases": [{ "binding": "DB", "database_name": "opportunity-os-crm", "database_id": "2ae85530-d536-4e22-b86c-2dc4dc4006e2" }],
  "kv_namespaces": [{ "binding": "SETTINGS", "id": "efcaeafd8ee842808cdbd2002637990d" }],
  // No borrar las variables que se añaden desde el panel de Cloudflare al publicar
  "keep_vars": true,
  "vars": {
    "AI_PROVIDER": "anthropic",
    "SENDER_NAME": "Kilian",
    "AGENCY_NAME": "Digital Zyra"
  }
  // Secretos (no van aquí): wrangler secret put APP_PASSWORD, SESSION_SECRET, CONTACT_EMAIL,
  // ANTHROPIC_API_KEY, GOOGLE_PLACES_API_KEY
}
